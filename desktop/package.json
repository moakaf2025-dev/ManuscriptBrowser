{
  "name": "manuscript-browser",
  "productName": "ManuscriptBrowser",
  "version": "2.5.0",
  "description": "متصفح المخطوطات - أداة سطح مكتب لمعاونة الباحث في المخطوطات",
  "main": "main.js",
  "author": "د. محمد عمر أحمد الكاف - moakaf2025@gmail.com",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable --x64 --publish=never; python3 scripts/patch-exe-icon.py dist/win-unpacked/ManuscriptBrowser.exe icon.ico"
  },
  "build": {
    "appId": "com.moakaf.manuscriptbrowser",
    "productName": "ManuscriptBrowser",
    "asar": true,
    "asarUnpack": [
      "icon.ico",
      "icon.png"
    ],
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "Create-Desktop-Shortcut.cmd",
        "to": "../Create-Desktop-Shortcut.cmd"
      },
      {
        "from": "Create-Desktop-Shortcut.ps1",
        "to": "../Create-Desktop-Shortcut.ps1"
      },
      {
        "from": "README-اقرأني.txt",
        "to": "../README-اقرأني.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "ManuscriptBrowser-${version}-portable.exe",
      "signAndEditExecutable": false
    },
    "electronDownload": {
      "cache": "/tmp/electron-cache"
    }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
